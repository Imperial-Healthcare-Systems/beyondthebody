# Beyond The Body — environment contract.
# Copy to .env.local for development. The schema in lib/env.ts is the source of truth;
# anything missing or malformed here refuses the server start rather than failing later,
# per request, in a harder-to-diagnose way.

# ─── Database ──────────────────────────────────────────────────────────────────────
# Postgres 13+ (gen_random_uuid() is used for primary keys).
DATABASE_URL=postgresql://btb:password@localhost:5432/btb
# Max connections in this process's pool. One app instance rarely needs more than 10.
DATABASE_POOL_MAX=10
# true if the database requires TLS (most managed providers do; a local socket does not).
DATABASE_SSL=false
# Only for a self-signed / internal-CA certificate, which a self-hosted Postgres often
# has. Turns OFF certificate verification: the connection stays encrypted but no longer
# proves who is on the other end, so it becomes interceptable on a hostile network.
# Leave false against any managed provider — they all present a trusted certificate.
DATABASE_SSL_INSECURE=false

# ─── Application ───────────────────────────────────────────────────────────────────
# Absolute public origin, NO trailing slash. Used to build links that are emailed to
# humans — newsletter confirmation, unsubscribe, admin magic links, order status. Wrong
# here means those links point at the wrong host.
APP_URL=http://localhost:3000

# At least 32 characters of randomness. Signs order-access tokens and hashes session
# tokens. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it signs every visitor out and invalidates every emailed order link.
SESSION_SECRET=

# ─── Reverse proxy ─────────────────────────────────────────────────────────────────
# How many proxies sit in front of this app. nginx alone = 1. Cloudflare + nginx = 2.
# This decides how many X-Forwarded-For entries are trusted. Leaving it 0 in production
# means client IPs cannot be determined and IP rate limits collapse into one shared
# bucket — safe, but over-restrictive. Setting it too HIGH is the dangerous direction:
# it lets a caller spoof the header and walk through every rate limit.
TRUSTED_PROXY_HOPS=0

# ─── Logging ───────────────────────────────────────────────────────────────────────
# debug | info | warn | error. One JSON object per line on stdout.
LOG_LEVEL=info

# ─── Background worker ─────────────────────────────────────────────────────────────
# Set false on any instance that should not process jobs (e.g. a build container).
# If several app instances run, leaving this true on all of them is fine — job claiming
# uses FOR UPDATE SKIP LOCKED, so they cannot collide.
WORKER_ENABLED=true
WORKER_POLL_MS=2000
WORKER_BATCH=5

# ─── Email ─────────────────────────────────────────────────────────────────────────
# Company SMTP, per client decision — not a sending provider.
#
# All of it is optional to BOOT: with no SMTP_HOST the app writes messages to the log
# instead of sending them, so development and CI need no mail server. In production that
# is a launch blocker, not a configuration — sign-in links, newsletter confirmations and
# order confirmations all silently go nowhere. startup.ts warns about it every boot.
SMTP_HOST=
SMTP_PORT=587
# true ONLY for implicit TLS on port 465. Port 587 uses STARTTLS and must stay false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The address the house sends as. Its domain needs SPF, DKIM and DMARC pointing at this
# server, or the mail arrives in spam — which looks identical to not sending it.
MAIL_FROM=Beyond The Body <no-reply@beyondthebody.com>
# Where the studio is told a new order arrived. Until the admin order list ships, this
# email is the ONLY notification — point it at a mailbox somebody reads each morning.
# Unset falls back to the MAIL_FROM address.
ORDERS_EMAIL=

# ─── Optional ──────────────────────────────────────────────────────────────────────
# Absent = structured logs only, which is a supported configuration.
SENTRY_DSN=
